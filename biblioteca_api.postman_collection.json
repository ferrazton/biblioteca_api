					"listen": "test",
					"script": {
						"exec": [
							"const auth = pm.response.headers.get('Authorization');\r",
							"if (auth) {\r",
							"  pm.environment.set('token', auth);\r",
							"  console.log(\"JWT saved:\", auth);\r",
							"} else {\r",
							"  pm.environment.unset('token');\r",
							"  console.log(\"No JWT found\");\r",
